# ---- Login Microsoft 365 (Entra ID) — Auth.js v5 ----
AUTH_SECRET=                      # openssl rand -base64 32
AUTH_MICROSOFT_ENTRA_ID_ID=       # Application (client) ID de l'app Entra
AUTH_MICROSOFT_ENTRA_ID_SECRET=   # Secret client
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<TENANT_ID>/v2.0
ALLOWED_EMAIL_DOMAINS=gamache.net # domaines autorisés, séparés par des virgules
ALLOWED_EMAILS=                   # optionnel : liste blanche de courriels (vide = tout le domaine)

# ---- Gamache Cloud (MongoDB Atlas) — usager EN LECTURE SEULE ----
MONGODB_URI=mongodb+srv://fiche360_ro:<mdp>@<cluster>.mongodb.net/?retryWrites=false
MONGODB_DB=                       # nom de la base Gamache Cloud

# ---- Gamache DWH via l'API Metabase (usager metabase_ro, lecture seule) ----
METABASE_URL=https://<metabase>.gamache.cloud
METABASE_API_KEY=                 # Admin → Paramètres → Authentification → Clés API
METABASE_DATABASE_ID=3

# ---- Analyse narrative (Anthropic) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ---- Photos ----
WEBSITE_BASE=https://groupegamache.com
CLOUD_BASE=https://gestion.gamache.cloud
